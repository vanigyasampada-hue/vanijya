# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://vanijya_sampada:vanijya_sampada_dev_pw@localhost:5432/vanijya_sampada?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT (RS256 — generate with scripts/generate-jwt-keys.sh) ──
JWT_PRIVATE_KEY_PATH="./keys/jwt_private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt_public.pem"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Bcrypt ────────────────────────────────────────────────
BCRYPT_COST=12

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# ── Rate limiting ─────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ── MinIO (S3-compatible file storage) ───────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="vanijya_sampada_minio"
MINIO_SECRET_KEY="vanijya_sampada_minio_dev_pw"
MINIO_BUCKET="vanijya-sampada-files"

# ── Captcha ───────────────────────────────────────────────
CAPTCHA_PROVIDER="builtin" # default: self-hosted captcha, no key needed; or "recaptcha" / "hcaptcha"
CAPTCHA_SECRET_KEY=""

# ── Swikriti challan portal (see lib/payment-links.ts) ────
# The exact query-parameter contract isn't documented in the source
# specs available here — confirm against Swikriti's real integration
# guide before production use.
SWIKRITI_PORTAL_BASE_URL=""

# ── Payment gateway webhooks (routes/payment-webhook.routes.ts) ────
# Left unset by default -- webhooks are REJECTED (not silently trusted)
# when their corresponding secret is empty. Only set these once a real
# gateway account exists to receive a shared signing secret from.
UPI_WEBHOOK_SECRET=""
SWIKRITI_WEBHOOK_SECRET=""

# Official report letterhead: printed as "GOVERNMENT OF <GOVERNMENT_NAME>" on every PDF report.
GOVERNMENT_NAME=Karnataka

# ── How staff get their one-day login code ─────────────────────────────────
# Empty = automatic: "sms" when SMS_PROVIDER is set; otherwise, in production,
# "admin" -- the official presses "Request code from administrator" and their
# administrator issues the code in the app (Users -> Login code), passing it on
# by phone/in person. Admin-issued codes also work alongside SMS (outages).
# The top State Admin gets one from the server: npm run odp:issue -- --username <name>
ODP_DELIVERY=""            # "" (automatic) | admin | sms

# ── SMS (staff login codes + merchant one-time passwords) ────────────────
# Choose ONE provider preset; only its settings are needed. Every provider in
# India needs TRAI DLT registration (sender ID + ONE TEMPLATE PER MESSAGE TYPE).
# In production an unset/incomplete provider is refused; System Health shows
# exactly what is missing, and "Send test SMS" proves the setup end to end.
SMS_PROVIDER=""            # "" = development only | fast2sms | msg91 | nic | http (custom)
SMS_API_KEY=""             # fast2sms / msg91 API key, or the NIC PIN
SMS_SENDER_ID=""           # your 6-letter DLT header, e.g. KARVSP
SMS_DLT_ENTITY_ID=""       # DLT Principal Entity ID
SMS_DLT_TEMPLATE_ID_ODP=""       # DLT template id: staff login code
SMS_DLT_TEMPLATE_ID_MERCHANT=""  # DLT template id: merchant one-time password
SMS_MESSAGE_TEMPLATE=""    # must match the approved DLT text; default below
SMS_MERCHANT_TEMPLATE=""   # must match the approved DLT text; default below
#   login code: "{code} is your Vanijya Sampada login code, valid for 24 hours. Do not share it with anyone. - Govt of Karnataka"
#   merchant:   "Vanijya Sampada: log in with your mobile {mobile} and temporary password {password}. You must change it at first login. - Govt of Karnataka"
#
# fast2sms: just the settings above (uses the dlt_manual route).
# msg91:    ALSO create one MSG91 template per message (variables ##VAR1##,
#           ##VAR2##, linked to its DLT template in the MSG91 dashboard):
SMS_PROVIDER_TEMPLATE_ODP=""       # MSG91 template id for the login code (VAR1 = code)
SMS_PROVIDER_TEMPLATE_MERCHANT=""  # MSG91 template id for the merchant password (VAR1 = mobile, VAR2 = password)
# nic:      ALSO the NIC account username:
SMS_NIC_USERNAME=""
# http:     any other provider (e.g. 2Factor) -- describe the request:
SMS_HTTP_METHOD="GET"
SMS_HTTP_URL=""            # placeholders: {mobile} {message} {sender_id} {dlt_entity_id} {dlt_template_id} {api_key}
SMS_HTTP_BODY=""
SMS_HTTP_HEADERS=""        # JSON object
SMS_HTTP_SUCCESS_PATTERN="" # regex the response must match
SMS_MOBILE_PREFIX="91"

# ── Production (docker-compose.prod.yml) ─────────────────────────────────
# Number of reverse proxies in front of the API. Leave EMPTY when the API is
# reached directly (local dev); the production compose sets 1 (nginx).
TRUST_PROXY=
# Public origin browsers use, e.g. https://vanijya.example.gov.in -- signed
# file links (photos, circulars) must name it; nginx proxies them to MinIO.
MINIO_PUBLIC_URL=
# Required by docker-compose.prod.yml (choose strong values; the dev
# defaults above must NOT be used in production).
POSTGRES_PASSWORD=
# Only for CAPTCHA_PROVIDER=recaptcha/hcaptcha: the provider's PUBLIC site
# key (secret in CAPTCHA_SECRET_KEY). The default built-in captcha needs none.
CAPTCHA_SITE_KEY=
# Build identifier shown in the footer and diagnostics (§5.7), e.g.:
#   APP_VERSION=$(git rev-parse --short HEAD) docker compose -f docker-compose.prod.yml up -d --build
APP_VERSION=
